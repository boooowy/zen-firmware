#include <zephyr/dt-bindings/gpio/nordic-nrf-gpio.h>
#include <dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include "zen_layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &zen_physical_layout;
        zmk,kscan = &kscan0;
        zmk,battery = &non_lipo_battery;
    };

    zen_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                   RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                   RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)  RC(2,7)  RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)  RC(3,7)                  RC(3,10) RC(3,11) RC(3,12) RC(3,13)
        >;
    };

    /* トラックボールを一定量動かしたときだけマウスレイヤー(1)に入る
       (ZMK標準の zip_temp_layer は最初の1イベントで即レイヤーONになるため自作)

       設計方針: 「入口はゆるく、出口を作る」
         - 入口(誤爆防止)は require-prior-idle-ms が主担当。距離は補助に留める
         - 出口は excluded-positions に載っていないキーの打鍵で即解除
       このプロパティ群はここ1箇所でのみ定義する (DTSは後勝ちのため多重定義は事故のもと) */
    /omit-if-no-ref/ zip_delay_temp_layer: zip_delay_temp_layer {
        compatible = "zmk,input-processor-delay-temp-layer";
        #input-processor-cells = <2>;
        activation-delay-ms = <0>;
        /* 断続的にゆっくり転がしても距離カウンタがリセットされないよう長めに取る */
        movement-gap-ms = <150>;

        /* 最後の打鍵からの経過時間で必要な移動量を三段階に切り替える (cpi=800)
             0-400ms    : 距離に関係なく入らない          (require-prior-idle-ms)
             400-1500ms : 96カウント ≒ 3.0mm  が必要      (activation-distance-after-typing)
             1500ms-    :  8カウント ≒ 0.25mm で入る      (activation-distance)
           打鍵中の微振動は 3mm に届かず、打鍵していないときは触れば入る。
           入りやすくても実害がないのは excluded-positions が打鍵で即解除するため */
        require-prior-idle-ms = <400>;
        activation-distance = <8>;
        activation-distance-after-typing = <96>;
        typing-window-ms = <1500>;

        /* ここに列挙した位置「以外」を押すとマウスレイヤーが即解除される。
           = マウス操作中に押したいキーのホワイトリスト。
           レイヤー1の割り当てを変えたら必ずここも更新すること。
           position 44 (左キーボード右下の lt 1/ESC) は意図的に含めない。
           オートマウス中に短押しするとレイヤー1を解除し、ESCとして動作する */
        excluded-positions = <
            3  4                 /* E R  -> Gui+Shift+[ ] タブ切替 */
            7  8  9              /* U I O -> LCLK / mo 4 / RCLK */
            15 16 17             /* D F G -> mo 4 / MB1 / MB2 */
            18 19 20 21 22       /* H J K L ; -> Gui+[ / MB1 / MB3 / MB2 / Gui+] */
            12 24 31 41 42       /* LCTRL LSHFT RCMD LALT LCMD */
            38                   /* mo 1 手動マウスレイヤー。ここを外すと
                                    押した瞬間にこのプロセッサがレイヤー1を落としてしまう */
            39                   /* tog 7 トラックボール速度切替 */
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        col-gpios
            = <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio1 15   (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 23   (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 10   (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio1 0    (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 9    (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio1 3    (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        row-gpios
            = <&gpio0 5 (GPIO_ACTIVE_HIGH)>,
            <&gpio0 0  (GPIO_ACTIVE_HIGH)>,
            <&gpio0 30 (GPIO_ACTIVE_HIGH)>,
            <&gpio0 3  (GPIO_ACTIVE_HIGH)>
            ;

        wakeup-source;
    };

    leds {
        compatible = "gpio-leds";
        status_led: status_led {
            gpios = <&bmp 2 GPIO_ACTIVE_HIGH>;
            label = "Status LED";
        };
    };

    status_led_device: status_led_device {
        compatible = "zmk,status-led";
        led = <&status_led>;
    };

    bootloader_trigger: bootloader_trigger {
        compatible = "zmk,cdc-acm-bootloader-trigger";
    };

    scroll_scaler: scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };

    pointing_listener: pointing_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
    };

    vbatt: vbatt {
        status = "disabled";
    };

    non_lipo_battery: non_lipo_battery {
        compatible = "zmk,non-lipo-battery";
        io-channels = <&adc 4>;
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 18)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 16)>,
                    <NRF_PSEL(SPIM_MISO, 0, 16)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 18)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 16)>,
                    <NRF_PSEL(SPIM_MISO, 0, 16)>;
        };
        low-power-enable;
    };

    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 18)>,
                    <NRF_PSEL(TWIM_SCL, 0, 16)>;
            bias-pull-up;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 18)>,
                    <NRF_PSEL(TWIM_SCL, 0, 16)>;
            bias-pull-up;
            low-power-enable;
        };
    };
};

&zen_physical_layout {
    kscan = <&kscan0>;
    transform = <&zen_transform>;
};
