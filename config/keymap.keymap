#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp TAB    &kp Q   &kp W   &kp E     &kp R             &kp T  &kp Y      &kp U              &kp I  &kp O           &kp P          &kp BSPC
&kp LCTRL  &kp A   &kp S   &kp D     &kp F             &kp G  &kp H      &kp J              &kp K  &kp L           &kp SEMICOLON  &kp ENTER
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V             &kp B  &kp SPACE  &kp RIGHT_COMMAND  &kp N  &kp M           &kp COMMA      &kp DOT    &kp SLASH  &mt RSHFT SINGLE_QUOTE
&mo 2      &trans  &trans  &kp LALT  &kp LEFT_COMMAND  &mo 2  &lt 3 ESC  &kp SPACE          &mo 6  &kp LEFT_ARROW  &kp BACKSLASH  &kp MINUS
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans    &trans                &mkp LCLK  &mo 4             &mkp RCLK  &trans                 &trans
&trans  &trans  &trans  &mo 4   &mkp MB1  &mkp MB2  &kp RG(LEFT_BRACKET)  &mkp MB1   &mkp MB3          &mkp MB2   &kp RG(RIGHT_BRACKET)  &trans
&trans  &trans  &trans  &trans  &trans    &trans    &trans                &trans     &kp LC(UP_ARROW)  &trans     &trans                 &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans    &trans                &trans     &trans            &trans     &trans                 &trans
            >;
        };

        layer_2 {
            bindings = <
&trans            &kp N1            &kp N2    &kp N3                &kp N4                 &kp N5     &kp N6    &kp N7    &kp N8        &kp N9     &kp N0     &trans
&kp LA(LEFT_GUI)  &kp LS(LA(LCMD))  &kp PLUS  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS  &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &kp MINUS  &trans
&kp LS(LCMD)      &trans            &trans    &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp EQUAL  &trans    &trans    &trans        &kp GRAVE  &kp TILDE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp NON_US_BACKSLASH
&kp LEFT_SHIFT    &trans            &trans    &trans                &trans                 &trans     &trans    &trans    &trans        &trans     &trans     &kp PIPE
            >;
        };

        layer_3 {
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp LCTRL  &kp AMPERSAND  &kp ASTERISK  &trans  &trans  &trans
&trans  &trans           &trans       &trans    &trans      &trans       &trans     &trans         &trans        &trans  &trans  &trans
&trans  &trans           &trans       &trans    &trans      &trans       &trans     &trans         &trans        &trans  &trans  &trans  &trans  &trans
&trans  &trans           &trans       &trans    &trans      &trans       &trans     &trans         &trans        &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
            >;
        };

        layer_6 {
            bindings = <
&trans        &kp F1        &kp F2        &kp F3        &kp F4        &kp F5      &trans          &kp FSLH  &kp ASTRK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9
&trans        &kp F6        &kp F7        &kp F8        &kp F9        &kp F10     &kp HOME        &trans    &kp MINUS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
&trans        &kp F11       &kp F12       &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &bt BT_CLR_ALL  &trans    &kp END    &trans           &kp GRAVE        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans          &trans    &trans     &kp KP_NUMBER_0  &kp DOT          &kp EQUAL
            >;
        };
    };
};
