#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        speed_a_to_b: speed_a_to_b {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&tog 7 &tog 8>;
        };

        speed_b_to_c: speed_b_to_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&tog 8 &tog 9>;
        };
    };

    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };

        switch-ime {
            bindings = <&kp LC(SPACE)>;
            key-positions = <15 16>;
            require-prior-idle-ms = <0>;
            timeout-ms = <30>;
            layers = <0 7 8 9>;
        };

        haifun {
            bindings = <&kp MINUS>;
            key-positions = <20 21>;
            timeout-ms = <30>;
            layers = <0 7 8 9>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <19 20>;
            timeout-ms = <30>;
            layers = <0 7 8 9>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp TAB    &kp Q   &kp W   &kp E     &kp R             &kp T  &kp Y      &kp U              &kp I  &kp O   &kp P          &kp BSPC
&kp LCTRL  &kp A   &kp S   &kp D     &kp F             &kp G  &kp H      &kp J              &kp K  &kp L   &kp SEMICOLON  &kp ENTER
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V             &kp B  &kp SPACE  &kp RIGHT_COMMAND  &kp N  &kp M   &kp COMMA      &kp DOT    &kp SLASH  &mt RSHFT SINGLE_QUOTE
&mo 1      &tog 7  &trans  &kp LALT  &kp LEFT_COMMAND  &mo 2  &lt 3 ESC  &lt 5 SPACE        &mo 6  &trans  &kp BACKSLASH  &kp MINUS
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans    &trans                &mkp LCLK  &mo 4     &mkp RCLK  &trans                 &trans
&trans  &trans  &trans  &mo 4   &mkp MB1  &mkp MB2  &kp RG(LEFT_BRACKET)  &mkp MB1   &mkp MB3  &mkp MB2   &kp RG(RIGHT_BRACKET)  &trans
&trans  &trans  &trans  &trans  &trans    &trans    &trans                &trans     &trans    &trans     &trans                 &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans    &trans                &trans     &trans    &trans     &trans                 &trans
            >;
        };

        layer_2 {
            bindings = <
&trans                  &kp N1            &kp N2    &kp N3                &kp N4                 &kp N5     &kp N6    &kp N7         &kp N8        &kp N9     &kp N0     &trans
&kp LA(LEFT_GUI)        &kp LS(LA(LCMD))  &kp PLUS  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS  &kp LEFT  &kp DOWN       &kp UP_ARROW  &kp RIGHT  &kp MINUS  &trans
&kp LS(LCMD)            &kp LEFT_SHIFT    &trans    &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp EQUAL  &trans    &trans         &trans        &kp GRAVE  &kp TILDE  &trans    &kp UNDER  &kp NON_US_BACKSLASH
&kp LA(LS(LEFT_SHIFT))  &trans            &trans    &trans                &trans                 &trans     &trans    &kp BACKSPACE  &trans        &trans     &trans     &kp PIPE
            >;
        };

        layer_3 {
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET  &kp AMPERSAND  &kp ASTERISK  &trans  &trans  &trans
&trans  &trans           &trans       &trans    &trans      &trans       &trans     &trans         &trans        &trans  &trans  &trans
&trans  &trans           &trans       &trans    &trans      &trans       &trans     &trans         &trans        &trans  &trans  &trans  &trans  &trans
&trans  &trans           &trans       &trans    &trans      &trans       &trans     &trans         &trans        &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans            &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5    &kp NUMBER_6    &kp N7          &kp N8        &kp N9           &kp N0  &trans
&kp LCTRL         &kp LEFT_GUI  &trans        &mo 4         &mkp MB1      &mkp MB2  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans  &trans
&kp LEFT_SHIFT    &trans        &trans        &trans        &trans        &trans    &trans          &trans          &trans        &trans           &trans  &trans  &trans  &trans
&kp LS(LEFT_ALT)  &trans        &trans        &trans        &trans        &trans    &trans          &trans          &trans        &trans           &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans        &kp F1        &kp F2        &kp F3        &kp F4        &kp F5      &trans          &kp FSLH  &kp ASTRK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9
&trans        &kp F6        &kp F7        &kp F8        &kp F9        &kp F10     &kp HOME        &trans    &kp MINUS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
&trans        &kp F11       &kp F12       &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &bt BT_CLR_ALL  &trans    &kp END    &trans           &kp GRAVE        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans          &trans    &trans     &kp KP_NUMBER_0  &kp DOT          &kp EQUAL
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans         &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans         &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans         &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &speed_a_to_b  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_8 {
            bindings = <
&trans  &trans         &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans         &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans         &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &speed_b_to_c  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_9 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &tog 9  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
